# ==============================================================================
# ThreadLine Environment Variables
# ==============================================================================

# 1. OpenRouter API Key (Required for LLM inference)
# Server-only. Do NOT prefix with NEXT_PUBLIC_
OPENROUTER_API_KEY="sk-or-v1-your-actual-openrouter-key"

# 2. Master Application Password Hash (Required for single-user authentication)
# Bcrypt hash generated using `npm run hash-password`
# Server-only. Do NOT prefix with NEXT_PUBLIC_
APP_PASSWORD_HASH="$2b$12$your-generated-bcrypt-hash"

# 3. Session Signing Secret (Required for JWT cookie signing)
# 64-character hex string generated using `npm run generate-secret`
# Server-only. Do NOT prefix with NEXT_PUBLIC_
SESSION_SECRET="your-generated-64-character-hex-session-secret"

# 4. Tavily Search API Key (Optional for Perplexity-style "Search the web" feature)
# Server-only. Do NOT prefix with NEXT_PUBLIC_
# When configured, users can toggle "Search the web" to enrich LLM answers with real-time web sources.
# When omitted, standard chat works normally; enabling web search will politely inform the user that web search is unavailable.
TAVILY_API_KEY="tvly-your-tavily-api-key"
